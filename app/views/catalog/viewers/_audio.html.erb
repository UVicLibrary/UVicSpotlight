<%# WARNING: avoid using @document in this partial because @document is only available in catalog#show. Use local variable document instead. %>
<% if document.compound_object? %>
  <% count = document.compound_ids.count %>
  <div class="osd-toolbar row">
    <div class="col-md-6 pagination">
      <a id="osd-previous" onclick="updatePlayer(this, <%= count %>);"><span class="carousel-control-prev-icon custom-chevron-left"></span></a>
      <span id="osd-page">1</span> of <%= count %>
      <a id="osd-next" onclick="updatePlayer(this, <%= count %>);"><span class="carousel-control-next-icon custom-chevron-right"></span></a>
    </div>
  </div>
<% end %>
<% documents = document.compound_object? ? document.child_docs : [document] %>
<% documents.each do |doc| %>
  <% display = (documents.index(doc) == 0 ? "block" : "none") %>
  <audio class="pull-left audioplayer" id="audio_<%= documents.index(doc) %>" style="display: <%= display %>" poster="<%= doc.thumbnail_url %>" controls>
    <source src="<%= doc.upload_url %>" type="video/mp4">
  </audio>
<% end %>