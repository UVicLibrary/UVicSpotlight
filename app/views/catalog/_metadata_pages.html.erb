<%# Renders file-level metadata for compound objects %>
<% if @child_docs %>
  <% @child_docs.each do |child_doc| %>
    <% display = (@child_docs.index(child_doc) == 0 ? "block" : "none") %>
    <div class="page metadata-page" id="page_<%= @child_docs.index(child_doc) %>" data-canvas-id="<%= child_doc.id %>" style="display: <%= display %>;">
      <% if can? :edit, child_doc %>
        <%= exhibit_edit_link child_doc, [:edit, current_exhibit, child_doc], class: 'pull-right btn btn-primary' %>
      <% end %>
      <div class="metadata-field">
        <dt class="blacklight-full_title_tesim" onclick="hideShow(event)">
          <%= fa_icon "chevron-down" %>
            Page Title:
        </dt>
        <dd class="blacklight-full_title_tesim"><%= child_doc['full_title_tesim'].try(:first) %></dd>
      </div>
      <%= render partial: "metadata_fields", locals: { fields: blacklight_config.show_fields, document: child_doc } %>
      <br/>
      <a role="button" class="btn btn-primary" id="download-current-image" target="_blank" href="<%= download_item_path(child_doc) %>">
        Download Current File
      </a>
    </div>
  <% end %>
<% end %>