<%# EXTEND blacklight v.8.3.0 - sanitize links in metadata field values
    (links are generated by CustomFieldPresenter). %>
<%= render(@layout.new(field: @field)) do |component| %>
  <% component.with_label do %>
    <%= label %>
  <% end %>
  <% component.with_value do %>
    <%= sanitize(@field.render) %>
  <% end %>
<% end %>
